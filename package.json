{
  "name": "blinders",
  "version": "1.1.0",
  "description": "Blinders for coding agents: a turn-level scope contract for Claude Code and OpenCode, enforced at the tool boundary.",
  "keywords": [
    "claude-code",
    "opencode",
    "coding-agents",
    "scope-control",
    "overengineering",
    "guardrails",
    "ai-agents",
    "developer-tools"
  ],
  "author": "Deepanshu Khokhar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deepanshu-Khokhar/blinders.git"
  },
  "homepage": "https://github.com/Deepanshu-Khokhar/blinders#readme",
  "bugs": {
    "url": "https://github.com/Deepanshu-Khokhar/blinders/issues"
  },
  "main": "./opencode/blinders.mjs",
  "bin": {
    "blinders": "./scripts/blinders.cjs"
  },
  "exports": {
    ".": "./opencode/blinders.mjs",
    "./server": "./opencode/blinders.mjs"
  },
  "files": [
    "server.mjs",
    "opencode/",
    "src/",
    "hooks/",
    "assets",
    "skills/",
    "assets/",
    "scripts/blinders.cjs",
    "scripts/case-bundle-lib.cjs",
    "scripts/generated/case-bundle-v1-validator.cjs",
    ".claude-plugin/",
    "INSTALL.md",
    "PRIVACY.md",
    "README.md"
  ],
  "scripts": {
    "blinders": "node scripts/blinders.cjs",
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=18",
    "opencode": ">=1.18.18 <2 || >=2.0.18 <3"
  },
  "dependencies": {
    "@opencode/schema": "2.0.26",
    "effect": "4.0.0-rc.112"
  }
}
